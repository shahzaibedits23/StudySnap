{
  "entities": {
    "Note": {
      "title": "Note",
      "description": "A saved study note generated by AI.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the note."
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns the note."
        },
        "timestamp": {
          "type": "number",
          "description": "Creation timestamp in milliseconds."
        },
        "questionText": {
          "type": "string",
          "description": "The original text question."
        },
        "questionImage": {
          "type": "string",
          "description": "The base64 encoded image of the question."
        },
        "explanation": {
          "type": "string"
        },
        "stepByStep": {
          "type": "string"
        },
        "eli10": {
          "type": "string"
        },
        "quizzes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctAnswerIndex": { "type": "number" }
            }
          }
        },
        "relatedTopics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "diagram": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "title": { "type": "string" },
            "code": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "searchSources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "searchQueries": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["id", "userId", "timestamp", "explanation", "stepByStep", "eli10", "quizzes", "relatedTopics"]
    }
  },
  "firestore": {
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Stores user's saved study notes."
    }
  }
}
